# Copy this file to .env and fill in your key:
#     cp .env.example .env
#
# .env is gitignored — never commit it.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- optional tuning ---

# Reasoning depth vs latency: low | medium | high | xhigh | max
# SFS_EFFORT=medium

# Max tool-call rounds before the agent gives up on one query
# SFS_MAX_ROUNDS=12

# Directories the agent may search, colon-separated. Defaults to $HOME.
# SFS_ALLOWED_ROOTS=/home/you:/mnt/data
